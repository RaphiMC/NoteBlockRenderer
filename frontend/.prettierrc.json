{
  "bracketSpacing": false,
  "bracketSameLine": true,
  "arrowParens": "avoid",
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/styles.css",
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte",
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
